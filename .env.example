# Database
POSTGRES_URL=postgresql://postgres:password@localhost:5432/bkmk

# Authentication
# JWT Secret - generate with: openssl rand -base64 32
# This is used to sign session tokens
AUTH_SECRET=your-secret-key-here

# Google OAuth (optional)
# Get these from Google Cloud Console: https://console.cloud.google.com
# Create OAuth 2.0 Client ID credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Configuration for API access
# Comma-separated allowlist of explicit origins permitted to make
# cross-site requests. There is no wildcard support.
# Leaving this empty (or unset) means same-origin requests only.
# Example:
# CORS_ORIGINS=https://app.example.com,https://example.com
CORS_ORIGINS=
